import { createFileRoute, ClientOnly, Link } from "@tanstack/react-router";
import { useQuery } from "@tanstack/react-query";
import { lazy, Suspense, useState } from "react";
import { Crosshair, X } from "lucide-react";
import { ALGIERS, directionsUrl, formatKm, isOpenNow, useGeo } from "@/lib/geo";
import { fetchNearStores } from "@/lib/sooqy";
import { OpenBadge, VerifiedBadge } from "@/components/sooqy/badges";

const StoreMap = lazy(() => import("@/components/sooqy/StoreMap"));

export const Route = createFileRoute("/map")({
  head: () => ({
    meta: [
      { title: "خريطة المحلات — SOOQY" },
      { name: "description", content: "خريطة تفاعلية للمحلات القريبة منك في الجزائر." },
      { property: "og:title", content: "خريطة محلات SOOQY" },
      { property: "og:description", content: "شاهد المحلات القريبة منك على الخريطة وانتقل إليها مباشرة." },
    ],
  }),
  component: MapPage,
});

function MapPage() {
  const { pos, denied } = useGeo();
  const [active, setActive] = useState<string | null>(null);
  const stores = useQuery({ queryKey: ["near-stores", null, pos?.lat, pos?.lng], queryFn: () => fetchNearStores(null, pos?.lat, pos?.lng) });
  const [center, setCenter] = useState(ALGIERS);
  const sel = stores.data?.find((s) => s.id === active);

  return (
    <div className="fixed inset-0 bottom-16 z-0">
      <ClientOnly fallback={<div className="size-full animate-pulse bg-muted" />}>
        <Suspense fallback={<div className="size-full animate-pulse bg-muted" />}>
          <StoreMap center={pos && center === ALGIERS ? pos : center} user={pos} stores={stores.data ?? []} activeId={active} onSelect={setActive} />
        </Suspense>
      </ClientOnly>

      <div className="absolute inset-x-4 top-4 z-[1000] flex items-center justify-between rounded-2xl bg-card/95 px-4 py-3 shadow-soft backdrop-blur">
        <div>
          <p className="font-bold">المحلات القريبة منك</p>
          <p className="text-[11px] text-muted-foreground">{denied ? "فعّل الموقع لحساب المسافة" : `${stores.data?.length ?? 0} محل`}</p>
        </div>
        <button
          aria-label="موقعي"
          onClick={() => pos && setCenter({ ...pos })}
          className="flex size-10 items-center justify-center rounded-full bg-ink text-ink-foreground"
        >
          <Crosshair className="size-4" />
        </button>
      </div>

      {sel && (
        <div className="absolute inset-x-3 bottom-3 z-[1000] space-y-3 rounded-3xl bg-card p-4 shadow-lift">
          <button aria-label="غلق" onClick={() => setActive(null)} className="absolute top-3 left-3 rounded-full bg-muted p-1.5">
            <X className="size-4" />
          </button>
          <div className="flex gap-3">
            <div className="size-16 shrink-0 overflow-hidden rounded-xl bg-muted">{sel.cover_url && <img src={sel.cover_url} alt="" className="size-full object-cover" />}</div>
            <div className="space-y-1">
              <p className="font-bold">{sel.name}</p>
              <div className="flex flex-wrap items-center gap-2">
                <OpenBadge open={isOpenNow(sel.opening_hours)} />
                {sel.is_verified && <VerifiedBadge />}
              </div>
              <p className="text-xs text-muted-foreground">
                {sel.commune} {sel.distance != null && `· ${formatKm(sel.distance)}`}
              </p>
            </div>
          </div>
          <div className="grid grid-cols-2 gap-2">
            <Link to="/stores/$storeId" params={{ storeId: sel.id }} className="rounded-xl bg-muted py-2.5 text-center text-sm font-bold">
              عرض السلع
            </Link>
            <a href={directionsUrl(sel.latitude, sel.longitude, sel.name)} target="_blank" rel="noreferrer" className="rounded-xl bg-primary py-2.5 text-center text-sm font-bold text-primary-foreground">
              اذهب إلى المحل
            </a>
          </div>
        </div>
      )}
    </div>
  );
}
