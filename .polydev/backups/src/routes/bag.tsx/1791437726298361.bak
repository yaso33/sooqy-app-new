import { createFileRoute, Link } from "@tanstack/react-router";
import { useQuery } from "@tanstack/react-query";
import { ArrowLeft, ShoppingBag, Trash2 } from "lucide-react";
import { useBag } from "@/lib/bag";
import { formatDA } from "@/lib/geo";
import { getOffersByIds, primaryImage } from "@/lib/sooqy";
import { QtyStepper } from "@/components/sooqy/qty-stepper";
import { EmptyState } from "@/components/sooqy/empty-state";

export const Route = createFileRoute("/bag")({
  head: () => ({
    meta: [
      { title: "سلة التسوق — SOOQY" },
      { name: "description", content: "راجع منتجاتك المختارة قبل إتمام الطلب والتوصيل." },
      { property: "og:title", content: "سلة التسوق — SOOQY" },
      { property: "og:description", content: "منتجاتك المختارة من المتاجر الجزائرية." },
    ],
  }),
  component: BagPage,
});

function BagPage() {
  const bag = useBag();
  const ids = bag.items.map((i) => i.offerId);
  const offers = useQuery({ queryKey: ["bag-offers", ids], queryFn: () => getOffersByIds(ids) });
  const rows = bag.items.map((i) => ({ ...i, offer: offers.data?.find((o) => o.id === i.offerId) }));
  const total = rows.reduce((s, r) => s + (r.offer?.price ?? 0) * r.quantity, 0);

  return (
    <div className="space-y-4 px-4 pb-44 pt-6">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">سلة التسوق</h1>
        {bag.items.length > 0 && (
          <button
            onClick={() => confirm("هل تريد إفراغ السلة؟") && bag.clear()}
            className="flex items-center gap-1 rounded-xl border bg-card px-3 py-2 text-xs font-semibold text-danger"
          >
            <Trash2 className="size-3.5" /> إفراغ السلة
          </button>
        )}
      </div>
      {bag.items.length === 0 && (
        <div className="space-y-3 rounded-3xl bg-card p-10 text-center shadow-soft">
          <ShoppingBag className="mx-auto size-12 text-muted-foreground" />
          <p className="font-bold">سلتك فارغة</p>
          <p className="text-sm text-muted-foreground">أضف منتجات من المتاجر القريبة منك.</p>
          <Link to="/explore" className="inline-block rounded-2xl bg-primary px-6 py-3 font-bold text-primary-foreground">
            تصفح المنتجات
          </Link>
        </div>
      )}
      {rows.map((r) => (
        <div key={r.offerId} className="flex gap-3 rounded-2xl bg-card p-3 shadow-soft">
          {r.offer ? (
            <Link to="/products/$productId" params={{ productId: r.offer.product_id }} className="size-20 shrink-0 overflow-hidden rounded-xl bg-muted">
              {primaryImage(r.offer.images) && <img src={primaryImage(r.offer.images)!} alt="" className="size-full object-cover" />}
            </Link>
          ) : (
            <div className="size-20 shrink-0 animate-pulse rounded-xl bg-muted" />
          )}
          <div className="min-w-0 flex-1 space-y-1">
            <p className="line-clamp-1 font-semibold">{r.offer?.product.name ?? "..."}</p>
            <p className="text-xs text-muted-foreground">
              {r.offer?.store.name} {Object.values(r.options).join(" · ")}
            </p>
            <p className="font-bold">{formatDA((r.offer?.price ?? 0) * r.quantity)}</p>
          </div>
          <div className="flex flex-col items-end justify-between">
            <button aria-label="حذف" onClick={() => bag.remove(r.offerId)}>
              <Trash2 className="size-4 text-danger" />
            </button>
            <div className="flex items-center rounded-full bg-muted">
              <button aria-label="إنقاص" onClick={() => bag.setQty(r.offerId, r.quantity - 1)} className="p-1.5">
                <Minus className="size-3" />
              </button>
              <span className="w-6 text-center text-sm font-bold">{r.quantity}</span>
              <button
                aria-label="زيادة"
                onClick={() => bag.setQty(r.offerId, Math.min(r.quantity + 1, r.offer?.stock_quantity ?? 10))}
                className="p-1.5"
              >
                <Plus className="size-3" />
              </button>
            </div>
          </div>
        </div>
      ))}
      {bag.items.length > 0 && (
        <Link to="/explore" className="block text-center text-sm font-bold text-primary">
          + مواصلة التسوق
        </Link>
      )}
      {bag.items.length > 0 && (
        <div className="fixed inset-x-0 bottom-[calc(4rem+env(safe-area-inset-bottom))] z-30 px-4">
          <div className="mx-auto max-w-xl rounded-3xl bg-ink p-4 text-ink-foreground shadow-lift">
            <div className="flex justify-between">
              <span>المجموع ({bag.count} منتج)</span>
              <b>{formatDA(total)}</b>
            </div>
            <p className="mt-1 text-xs opacity-70">تُحسب تكلفة التوصيل حسب الولاية في الخطوة التالية.</p>
            <Link
              to="/checkout"
              className="mt-3 flex items-center justify-center gap-2 rounded-2xl bg-primary py-3 font-bold text-primary-foreground"
            >
              متابعة الطلب <ArrowLeft className="size-4" />
            </Link>
          </div>
        </div>
      )}
    </div>
  );
}
