import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { toast } from "sonner";
import {
  Bell,
  ChevronLeft,
  Heart,
  HelpCircle,
  LogOut,
  Package,
  Store,
  Timer,
} from "lucide-react";
import { supabase } from "@/integrations/supabase/client";
import { MerchantUpgradeCard } from "@/components/sooqy/MerchantUpgradeCard";
import { useAuth } from "@/lib/auth";
import { becomeMerchant, cancelReservation, fetchMyOrders, fetchMyReservations, fetchMyRoles } from "@/lib/sooqy";
import { useFavorites } from "@/lib/favorites";

export const Route = createFileRoute("/account")({
  head: () => ({
    meta: [
      { title: "حسابي — SooQy" },
      { name: "description", content: "طلباتك وحجوزاتك ومفضلتك في SooQy." },
    ],
  }),
  component: AccountPage,
});

const STATUS: Record<string, string> = {
  pending: "في الانتظار",
  collected: "تم الاستلام",
  cancelled: "ملغى",
  expired: "منتهي",
  confirmed: "مؤكد",
  shipped: "في الطريق",
  delivered: "وصل",
};

function AccountPage() {
  const { user, ready } = useAuth();
  const qc = useQueryClient();
  const navigate = useNavigate();
  const favorites = useFavorites();
  const roles = useQuery({ queryKey: ["my-roles"], queryFn: fetchMyRoles, enabled: !!user });
  const res = useQuery({ queryKey: ["my-reservations"], queryFn: fetchMyReservations, enabled: !!user });
  const orders = useQuery({ queryKey: ["my-orders"], queryFn: fetchMyOrders, enabled: !!user });
  const isMerchant = roles.data?.includes("merchant") ?? false;

  if (!ready) return null;
  if (!user)
    return (
      <div className="flex min-h-[70vh] flex-col items-center justify-center gap-4 px-6 text-center">
        <span className="flex size-20 items-center justify-center rounded-3xl bg-primary-soft">
          <Package className="size-9 text-primary" strokeWidth={1.6} />
        </span>
        <h1 className="text-h1 text-foreground">سجّل الدخول لحسابك</h1>
        <p className="max-w-xs text-body text-muted-foreground">
          طلباتك، حجوزاتك ومفضلتك في مكان واحد.
        </p>
        <Link to="/auth" className="btn-primary mt-2">
          دخول
        </Link>
        <Link to="/help" className="text-xs font-semibold text-muted-foreground underline">
          مساعدة والأسئلة الشائعة
        </Link>
      </div>
    );

  const signOut = async () => {
    await qc.cancelQueries();
    qc.clear();
    await supabase.auth.signOut();
    navigate({ to: "/auth", replace: true });
  };

  const name = (user.user_metadata?.full_name as string | undefined) ?? "مستخدم SooQy";
  const initial = (user.email ?? "؟").slice(0, 1).toUpperCase();

  return (
    <div className="space-y-5 px-4 pt-6">
      {/* بطاقة المستخدم */}
      <header className="flex items-center gap-3 rounded-2xl border border-border bg-card p-4">
        <span className="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-primary text-xl font-extrabold text-primary-foreground">
          {initial}
        </span>
        <div className="min-w-0 flex-1">
          <h1 className="line-clamp-1 text-h3 text-foreground">{name}</h1>
          <p className="truncate text-xs text-muted-foreground">{user.email}</p>
        </div>
        <button onClick={signOut} aria-label="تسجيل الخروج" className="icon-btn shrink-0">
          <LogOut className="size-4" />
        </button>
      </header>

      {/* الإحصائيات */}
      <div className="grid grid-cols-3 gap-2">
        <StatCard icon={Package} label="طلبات" value={orders.data?.length ?? 0} to="/orders" />
        <StatCard icon={Timer} label="حجوزات" value={res.data?.length ?? 0} />
        <StatCard
          icon={Heart}
          label="مفضلة"
          value={favorites.products.length + favorites.stores.length}
          to="/favorites"
        />
      </div>

      {/* القائمة */}
      <nav className="space-y-1 rounded-2xl border border-border bg-card p-2">
        <MenuItem to="/orders" icon={Package} label="طلباتي" />
        <MenuItem to="/favorites" icon={Heart} label="المفضلة" />
        <MenuItem to="/notifications" icon={Bell} label="الإشعارات" />
        {isMerchant && <MenuItem to="/studio" icon={Store} label="التاجر — متجري" />}
        <MenuItem to="/help" icon={HelpCircle} label="المساعدة والأسئلة الشائعة" />
      </nav>

      {!isMerchant && (
        <MerchantUpgradeCard
          isMerchant={isMerchant}
          onBecomeMerchant={async () => {
            await becomeMerchant();
            await qc.invalidateQueries({ queryKey: ["my-roles"] });
            await roles.refetch();
          }}
        />
      )}

      {/* الحجوزات */}
      <section className="space-y-2">
        <h2 className="text-h3 text-foreground">حجوزاتي</h2>
        {res.isLoading && <div className="h-20 animate-pulse rounded-2xl border border-border bg-card" />}
        {!res.isLoading && res.data?.length === 0 && (
          <p className="rounded-2xl border border-border bg-card p-4 text-sm text-muted-foreground">
            لا توجد حجوزات حالياً — احجز منتجًا واستلمه من المتجر.
          </p>
        )}
        {res.data?.map((r) => (
          <div key={r.id} className="flex items-center justify-between rounded-2xl border border-border bg-card p-3">
            <div className="min-w-0">
              <p className="font-mono font-bold text-primary">{r.code}</p>
              <p className="line-clamp-1 text-xs text-foreground">
                {r.offer?.product?.name} · {r.store?.name}
              </p>
              <p className="text-[11px] text-muted-foreground">{STATUS[r.status]}</p>
            </div>
            {r.status === "pending" && (
              <button
                onClick={async () => {
                  try {
                    await cancelReservation(r.id);
                    qc.invalidateQueries({ queryKey: ["my-reservations"] });
                  } catch (e) {
                    toast.error((e as Error).message);
                  }
                }}
                className="shrink-0 rounded-lg border border-border px-3 py-1.5 text-xs font-semibold text-danger"
              >
                إلغاء
              </button>
            )}
          </div>
        ))}
      </section>
    </div>
  );
}

function StatCard({
  icon: Icon,
  label,
  value,
  to,
}: {
  icon: typeof Package;
  label: string;
  value: number;
  to?: string;
}) {
  const inner = (
    <div className="flex flex-col items-center gap-1 rounded-2xl border border-border bg-card py-3.5">
      <Icon className="size-5 text-primary" strokeWidth={2.2} />
      <span className="text-h3 text-foreground">{value}</span>
      <span className="text-[11px] font-semibold text-muted-foreground">{label}</span>
    </div>
  );
  return to ? <Link to={to}>{inner}</Link> : inner;
}

function MenuItem({
  to,
  icon: Icon,
  label,
}: {
  to: string;
  icon: typeof Package;
  label: string;
}) {
  return (
    <Link
      to={to}
      className="flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold text-foreground transition hover:bg-neutral-100 active:bg-neutral-200 dark:hover:bg-neutral-800"
    >
      <span className="flex size-9 items-center justify-center rounded-xl bg-primary-soft text-primary">
        <Icon className="size-4" />
      </span>
      <span className="flex-1">{label}</span>
      <ChevronLeft className="size-4 text-muted-foreground" />
    </Link>
  );
}