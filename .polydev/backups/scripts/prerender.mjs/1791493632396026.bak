// توليد index.html حقيقي عبر SSR (prerender) لبناء الجوال:
// TanStack Start client يتطلب حمولة __TSR__ التي يصدّرها الخادم — الملفات الثابتة
// وحدها (كما في WebView) تترك #root فارغًا → شاشة بيضاء صامتة.
// الحل: تشغيل خادم Nitro المبني (dist/server/server.js) محليًا، جلب /،
// وحفظ HTML الناتج (تطبيق مُصدَّر + حمولة hydration) في dist/client/index.html.
import { readFileSync, writeFileSync, existsSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const SERVER_ENTRY = path.join(ROOT, "dist", "server", "server.js");
const CLIENT_INDEX = path.join(ROOT, "dist", "client", "index.html");

async function main() {
  if (!existsSync(SERVER_ENTRY)) throw new Error(`خادم Nitro غير موجود: ${SERVER_ENTRY} — نفّذ npm run build أولًا`);

  const fallbackHtml = buildFallbackHtml();

  try {
    // تحميل متغيرات البيئة من .env (إن وُجد) — مثل ما يفعل Vite
    const envPath = path.join(ROOT, ".env");
    if (existsSync(envPath)) {
      for (const line of readFileSync(envPath, "utf8").split("\n")) {
        const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/);
        if (m && !(m[1] in process.env)) process.env[m[1]] = m[2];
      }
    }

    const { default: server } = await import(`${SERVER_ENTRY}?t=${Date.now()}`);
    const request = new Request("http://localhost/", {
      headers: { accept: "text/html", "user-agent": "sooqy-prerender" },
    });
    const response = await server.fetch(request, {}, {});
    const html = await response.text();

    if (!html || html.length < 200 || !html.includes("<div id=\"root\"")) {
      throw new Error(`استجابة SSR غير صالحة (${response.status}, ${html.length} بايت)`);
    }

    // تحويل المسارات المطلقة إلى نسبية — توافق WebView (https://localhost/ و file://)
    const relative = html
      .replaceAll('href="/assets/', 'href="assets/')
      .replaceAll('src="/assets/', 'src="assets/')
      .replaceAll('href="/manifest.webmanifest"', 'href="manifest.webmanifest"')
      .replaceAll('href="/icon-192.png"', 'href="icon-192.png"')
      .replaceAll('href="/favicon.ico"', 'href="favicon.ico"');

    writeFileSync(CLIENT_INDEX, relative);
    const hasPayload = relative.includes("__TSR__") || relative.includes("__stream");
    console.log(`✅ prerender: ${html.length} بايت → dist/client/index.html (حمولة hydration: ${hasPayload ? "موجودة" : "غير موجودة"})`);
  } catch (error) {
    // fallback: إبقاء index.html الحالي (سلوك ما قبل prerender) مع تحذير
    writeFileSync(CLIENT_INDEX, fallbackHtml);
    console.error(`⚠️ prerender فشل — استُخدم index.html الحالي (شاشة بيضاء محتملة): ${error instanceof Error ? error.message : error}`);
    process.exitCode = 1;
  }
}

main();