// فحص دقيق v2: استيرادات نسبية داخل المجلد + استيراد ديناميكي + مراجع الكونفيج
import fs from "node:fs";
import path from "node:path";

const root = process.cwd();
function walk(dir, out = []) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walk(p, out);
    else out.push(p);
  }
  return out;
}

const srcFiles = walk(path.join(root, "src")).filter((f) => /\.(ts|tsx)$/.test(f));
const allSrc = srcFiles.map((f) => fs.readFileSync(f, "utf8")).join("\n");
const rootConfigs = ["vite.config.ts", "vitest.config.ts", "eslint.config.js", "capacitor.config.ts", "tsconfig.json"]
  .map((f) => (fs.existsSync(f) ? fs.readFileSync(f, "utf8") : ""))
  .join("\n");
const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));
const allText = allSrc + rootConfigs + JSON.stringify(pkg.scripts);

function used(name) {
  return (
    allText.includes(`components/ui/${name}`) ||
    allText.includes(`components/sooqy/${name}`) ||
    allText.includes(`components/ui/${name}`) ||
    new RegExp(`from ["'][^"']*${name}["']`).test(allText) || // نسبي ./name أو مسار
    new RegExp(`import\\(["'][^"']*${name}["']\\)`).test(allText) || // ديناميكي
    new RegExp(`["']\\./${name}["']`).test(allText) ||
    new RegExp(`["']\\.\\./${name}["']`).test(allText)
  );
}

console.log("=== ui components غير مستخدمة (دقيق) ===");
const uiDir = "src/components/ui";
const unusedUi = [];
for (const f of fs.readdirSync(uiDir)) {
  const n = f.replace(/\.tsx?$/, "");
  if (!used(n)) unusedUi.push(f);
}
unusedUi.forEach((u) => console.log(" -", u));

console.log("=== sooqy components غير مستورة ===");
for (const f of fs.readdirSync("src/components/sooqy")) {
  const n = f.replace(/\.tsx?$/, "");
  if (!used(n)) console.log(" -", f);
}

console.log("=== ملفات src أخرى غير مستخدمة ===");
const skipDirs = new Set(["routes", "ui", "sooqy", "test"]);
for (const f of srcFiles) {
  const rel = path.relative(root, f);
  if (/src\/(routes|test)\//.test(rel)) continue;
  if (/src\/components\/(ui|sooqy)\//.test(rel)) continue;
  if (["src/router.tsx", "src/server.ts", "src/start.ts"].includes(rel)) continue;
  const n = path.basename(f).replace(/\.tsx?$/, "");
  if (!used(n)) console.log(" -", rel);
}

console.log("=== اعتمادات مشبوهة: أين تُستخدم؟ ===");
const suspects = ["zod", "@hookform/resolvers", "react-hook-form", "@tanstack/router-plugin", "nitro", "postgres", "pg", "recharts", "react-day-picker", "react-resizable-panels", "vaul", "cmdk", "input-otp", "leaflet", "react-leaflet", "sonner", "embla-carousel-react", "date-fns", "tw-animate-css", "vite-plugin-pwa", "@radix-ui/react-select", "@radix-ui/react-dialog", "@radix-ui/react-tabs", "@radix-ui/react-dropdown-menu", "@radix-ui/react-popover", "@radix-ui/react-switch", "@radix-ui/react-checkbox", "@radix-ui/react-radio-group", "@radix-ui/react-slider", "@radix-ui/react-tooltip", "@radix-ui/react-accordion", "@radix-ui/react-avatar", "@radix-ui/react-label", "@radix-ui/react-slot", "@radix-ui/react-progress", "@radix-ui/react-scroll-area", "@radix-ui/react-toggle", "@radix-ui/react-separator", "@radix-ui/react-hover-card", "@radix-ui/react-menubar", "@radix-ui/react-navigation-menu", "@radix-ui/react-context-menu", "@radix-ui/react-collapsible", "@radix-ui/react-alert-dialog", "@radix-ui/react-aspect-ratio", "@radix-ui/react-toggle-group", "@radix-ui/react-accordion"];
for (const d of [...new Set(suspects)]) {
  const inSrc = allSrc.includes(d) || allSrc.includes(d.split("/").pop());
  const inCfg = rootConfigs.includes(d);
  console.log(` ${inSrc || inCfg ? "USED  " : "UNUSED"} ${d}`);
}
