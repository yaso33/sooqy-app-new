// بناء تطبيق الجوال (Capacitor):
// 1) npm run build → ينتج dist/client (أصول) و dist/server (خادم Nitro)
// 2) prerender → توليد index.html حقيقي عبر SSR (يحتوي حمولة __TSR__ للـ hydration)
// 3) npx cap sync android → ينسخ الأصول إلى مشروع أندرويد
import { execSync } from "node:child_process";
import { existsSync } from "node:fs";

const ROOT = new URL("..", import.meta.url).pathname;
process.chdir(ROOT);

console.log("📦 1/3 بناء الويب...");
execSync("npm run build", { stdio: "inherit" });

const clientDir = "dist/client";
if (!existsSync(`${clientDir}/assets`)) throw new Error("لم يوجد مجلد assets — تأكد من نجاح npm run build");

console.log("🖨️  2/3 توليد index.html عبر SSR (prerender)...");
execSync("node scripts/prerender.mjs", { stdio: "inherit" });

console.log("📱 3/3 مزامنة Capacitor...");
execSync("npx cap sync android", { stdio: "inherit" });
console.log("✅ جاهز — ابنِ APK عبر: cd android && ./gradlew assembleDebug");