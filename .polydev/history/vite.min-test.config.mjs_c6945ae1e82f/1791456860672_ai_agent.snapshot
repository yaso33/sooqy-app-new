import { defineConfig } from "vite";
import tailwindcss from "@tailwindcss/vite";
import tsConfigPaths from "vite-tsconfig-paths";
import react from "@vitejs/plugin-react";
import { fileURLToPath } from "node:url";

const step = process.env.TEST_STEP;

export default defineConfig(async () => {
  const plugins = [];
  if (step === "tailwind") plugins.push(tailwindcss());
  if (step === "tsconfig") plugins.push(tsConfigPaths({ projects: ["./tsconfig.json"] }));
  if (step === "react") plugins.push(react());
  if (step === "tanstack") {
    const { tanstackStart } = await import("@tanstack/react-start/plugin/vite");
    plugins.push(tanstackStart({ server: { entry: "server" } }));
  }
  if (step === "devtools") {
    const { devtools } = await import("@tanstack/devtools-vite");
    plugins.push(devtools({ logging: false }));
  }
  return {
    plugins,
    resolve: { alias: { "@": fileURLToPath(new URL("./src", import.meta.url)) } },
  };
});