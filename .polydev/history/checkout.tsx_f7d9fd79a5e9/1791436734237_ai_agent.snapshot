import { useState } from "react";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { Check, CreditCard, PackageCheck, Truck, Upload } from "lucide-react";
import { toast } from "sonner";
import { useAuth } from "@/lib/auth";
import { useBag } from "@/lib/bag";
import { formatDA } from "@/lib/geo";
import { createOrderWithDelivery, getOffersByIds, primaryImage } from "@/lib/sooqy";
import { WilayaSelect } from "@/components/sooqy/WilayaSelect";
import { cn } from "@/lib/utils";

export const Route = createFileRoute("/checkout")({
  head: () => ({
    meta: [
      { title: "الدفع — SOOQY" },
      { name: "description", content: "أكمل طلبك من المحلات الجزائرية." },
    ],
  }),
  component: CheckoutPage,
});

type DeliveryType = "home" | "desk";
type PaymentMethod = "cod" | "baridimob";

function CheckoutPage() {
  const { user, ready } = useAuth();
  const navigate = useNavigate();
  const bag = useBag();
  const qc = useQueryClient();
  const [deliveryType, setDeliveryType] = useState<DeliveryType>("home");
  const [wilayaId, setWilayaId] = useState<number | null>(null);
  const [commune, setCommune] = useState("");
  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod>("cod");
  const [fullName, setFullName] = useState(user?.user_metadata?.full_name ?? "");
  const [phone, setPhone] = useState(user?.phone ?? "");
  const [address, setAddress] = useState("");
  const [receipt, setReceipt] = useState<File | null>(null);
  const [submitting, setSubmitting] = useState(false);
  const offers = useQuery({
    queryKey: ["checkout-offers", bag.items],
    queryFn: () => getOffersByIds(bag.items.map((i) => i.offerId)),
    enabled: bag.items.length > 0,
  });
  const rows = bag.items.map((item) => ({
    ...item,
    offer: offers.data?.find((offer) => offer.id === item.offerId),
  }));
  const subtotal = rows.reduce((sum, row) => sum + (row.offer?.price ?? 0) * row.quantity, 0);
  const shippingFee = wilayaId ? getShippingFee(wilayaId, deliveryType) : 0;
  const total = subtotal + shippingFee;
  const valid =
    bag.items.length > 0 &&
    !!wilayaId &&
    !!commune.trim() &&
    !!fullName.trim() &&
    !!phone.trim() &&
    (!paymentMethod || paymentMethod !== "baridimob" || !!receipt);

  if (!ready) return null;
  if (!user) {
    return (
      <div className="space-y-4 px-4 pt-16 text-center">
        <PackageCheck className="mx-auto size-12 text-primary" />
        <h1 className="text-2xl font-bold">تحتاج لدخول الحساب</h1>
        <p className="text-sm text-muted-foreground">لإتمام الطلب، سجّل الدخول أولًا.</p>
        <Link
          to="/auth"
          search={{ redirect: "/checkout" }}
          className="inline-block rounded-2xl bg-primary px-8 py-3 font-bold text-primary-foreground"
        >
          دخول
        </Link>
      </div>
    );
  }
  if (bag.items.length === 0) {
    return (
      <div className="space-y-4 px-4 pt-16 text-center">
        <PackageCheck className="mx-auto size-12 text-primary" />
        <h1 className="text-2xl font-bold">السلة فارغة</h1>
        <Link
          to="/explore"
          className="inline-block rounded-2xl bg-primary px-8 py-3 font-bold text-primary-foreground"
        >
          تصفّح المنتجات
        </Link>
      </div>
    );
  }

  const placeOrder = async () => {
    if (!valid) {
      toast.error("أكمل المعلومات المطلوبة قبل إرسال الطلب.");
      return;
    }
    setSubmitting(true);
    try {
      await createOrderWithDelivery(
        bag.items,
        deliveryType,
        wilayaId,
        commune.trim(),
        paymentMethod,
        receipt,
        { fullName: fullName.trim(), phone: phone.trim(), address: address.trim() },
      );
      bag.clear();
      qc.clear();
      toast.success("تم إرسال الطلب بنجاح ✅");
      navigate({ to: "/account", replace: true });
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "ما تمشاش الطلب.");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="space-y-5 px-4 pb-24 pt-6">
      <header className="flex items-start justify-between gap-3">
        <div>
          <p className="text-sm text-muted-foreground">الدفع والتوصيل</p>
          <h1 className="text-2xl font-bold">إتمام الطلب</h1>
        </div>
        <span className="rounded-full bg-primary/10 px-3 py-1.5 text-xs font-bold text-primary">
          {bag.count} سلعة
        </span>
      </header>

      <section className="rounded-3xl bg-card p-4 shadow-soft">
        <div className="mb-3 flex items-center gap-2">
          <Truck className="size-5 text-primary" />
          <h2 className="font-bold">سلعك</h2>
        </div>
        <div className="space-y-3">
          {rows.map((row) => (
            <div key={row.offerId} className="flex gap-3 rounded-2xl bg-background p-3">
              <div className="size-16 shrink-0 overflow-hidden rounded-xl bg-muted">
                {row.offer && primaryImage(row.offer.images) && (
                  <img
                    src={primaryImage(row.offer.images)!}
                    alt=""
                    className="size-full object-cover"
                  />
                )}
              </div>
              <div className="min-w-0 flex-1">
                <p className="line-clamp-1 text-sm font-bold">{row.offer?.product.name ?? "..."}</p>
                <p className="text-xs text-muted-foreground">
                  {row.offer?.store.name} · الكمية {row.quantity}
                </p>
              </div>
              <p className="text-sm font-bold">
                {formatDA((row.offer?.price ?? 0) * row.quantity)}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section className="space-y-4 rounded-3xl bg-card p-4 shadow-soft">
        <div className="flex items-center gap-2">
          <Truck className="size-5 text-primary" />
          <h2 className="font-bold">طريقة التوصيل</h2>
        </div>
        <div className="grid grid-cols-2 gap-2">
          {(
            [
              { id: "home", label: "توصيل للمنزل", icon: "🏠" },
              { id: "desk", label: "استلام من المكتب", icon: "📍" },
            ] as const
          ).map((option) => (
            <button
              key={option.id}
              type="button"
              onClick={() => setDeliveryType(option.id)}
              className={cn(
                "rounded-2xl border p-3 text-sm font-bold",
                deliveryType === option.id
                  ? "border-primary bg-primary/10 text-primary"
                  : "bg-muted",
              )}
            >
              <span className="block text-lg">{option.icon}</span>
              {option.label}
            </button>
          ))}
        </div>
        <WilayaSelect value={wilayaId} onChange={setWilayaId} required className="h-12 w-full" />
        <input
          value={commune}
          onChange={(e) => setCommune(e.target.value)}
          placeholder="البلدية"
          required
          className="h-12 w-full rounded-xl border bg-background px-3"
        />
        {deliveryType === "home" && (
          <textarea
            value={address}
            onChange={(e) => setAddress(e.target.value)}
            placeholder="عنوان التوصيل التفصيلي"
            rows={3}
            className="w-full rounded-xl border bg-background px-3 py-2"
          />
        )}
      </section>

      <section className="space-y-4 rounded-3xl bg-card p-4 shadow-soft">
        <div className="flex items-center gap-2">
          <PackageCheck className="size-5 text-primary" />
          <h2 className="font-bold">بيانات المشتري</h2>
        </div>
        <div className="space-y-3">
          <input
            value={fullName}
            onChange={(e) => setFullName(e.target.value)}
            placeholder="الاسم الكامل"
            required
            className="h-12 w-full rounded-xl border bg-background px-3 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15"
          />
          <input
            value={phone}
            onChange={(e) => setPhone(e.target.value)}
            placeholder="رقم الهاتف"
            required
            className="h-12 w-full rounded-xl border bg-background px-3 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/15"
          />
        </div>
      </section>

      <section className="space-y-3 rounded-3xl bg-card p-4 shadow-soft">
        <div className="flex items-center gap-2">
          <CreditCard className="size-5 text-primary" />
          <h2 className="font-bold">طريقة الدفع</h2>
        </div>
        {(
          [
            { id: "cod", label: "الدفع عند الاستلام", icon: CreditCard },
            { id: "baridimob", label: "BaridiMob", icon: Upload },
          ] as const
        ).map(({ id, label, icon: Icon }) => (
          <button
            key={id}
            type="button"
            onClick={() => setPaymentMethod(id)}
            className={cn(
              "flex w-full items-center justify-between rounded-2xl border p-3 text-right",
              paymentMethod === id ? "border-primary bg-primary/10" : "bg-muted",
            )}
          >
            <span className="flex items-center gap-2 font-bold">
              <Icon className="size-4" />
              {label}
            </span>
            {paymentMethod === id && <Check className="size-4 text-primary" />}
          </button>
        ))}
        {paymentMethod === "baridimob" && (
          <label className="block rounded-2xl border border-dashed bg-background p-3 text-center text-sm">
            <Upload className="mx-auto mb-2 size-5 text-primary" />
            <input
              type="file"
              accept="image/*"
              onChange={(e) => setReceipt(e.target.files?.[0] ?? null)}
              className="hidden"
            />
            {receipt ? receipt.name : "ارفع صورة وصل التحويل"}
          </label>
        )}
      </section>

      <section className="rounded-3xl bg-ink p-4 text-ink-foreground">
        <div className="flex justify-between text-sm">
          <span>المجموع</span>
          <b>{formatDA(subtotal)}</b>
        </div>
        <div className="mt-2 flex justify-between text-sm">
          <span>تكلفة التوصيل</span>
          <b>{formatDA(shippingFee)}</b>
        </div>
        <div className="mt-3 flex justify-between border-t border-white/10 pt-3 text-base font-bold">
          <span>الإجمالي</span>
          <b>{formatDA(total)}</b>
        </div>
        <button
          disabled={submitting || !valid}
          onClick={placeOrder}
          className="mt-4 w-full rounded-2xl bg-primary py-3 font-bold text-primary-foreground disabled:opacity-45"
        >
          {submitting ? "جارٍ إرسال الطلب..." : "تأكيد الطلب"}
        </button>
      </section>
    </div>
  );
}

function getShippingFee(wilayaId: number, deliveryType: DeliveryType) {
  if (deliveryType === "desk") return 0;
  const base = { 1: 800, 2: 900 } as Record<number, number>;
  const amount = base[wilayaId] ?? 700;
  return amount + 100;
}
