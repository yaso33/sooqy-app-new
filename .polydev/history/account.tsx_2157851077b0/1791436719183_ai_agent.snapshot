import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { toast } from "sonner";
import { supabase } from "@/integrations/supabase/client";
import { MerchantUpgradeCard } from "@/components/sooqy/MerchantUpgradeCard";
import { useAuth } from "@/lib/auth";
import { becomeMerchant, cancelReservation, fetchMyOrders, fetchMyReservations } from "@/lib/sooqy";
import { fetchMyRoles } from "@/lib/sooqy";
import { formatDA } from "@/lib/geo";

export const Route = createFileRoute("/account")({
  head: () => ({
    meta: [
      { title: "حسابي — SOOQY" },
      { name: "description", content: "حجوزاتك وطلباتك في SOOQY." },
      { property: "og:title", content: "حسابي — SOOQY" },
      { property: "og:description", content: "تابع حجوزاتك وطلباتك." },
    ],
  }),
  component: AccountPage,
});

const STATUS: Record<string, string> = {
  pending: "في الانتظار",
  collected: "تم الاستلام",
  cancelled: "ملغى",
  expired: "منتهي",
  confirmed: "مؤكد",
  shipped: "في الطريق",
  delivered: "وصل",
};

function AccountPage() {
  const { user, ready } = useAuth();
  const qc = useQueryClient();
  const navigate = useNavigate();
  const roles = useQuery({ queryKey: ["my-roles"], queryFn: fetchMyRoles, enabled: !!user });
  const res = useQuery({
    queryKey: ["my-reservations"],
    queryFn: fetchMyReservations,
    enabled: !!user,
  });
  const orders = useQuery({ queryKey: ["my-orders"], queryFn: fetchMyOrders, enabled: !!user });
  const isMerchant = roles.data?.includes("merchant") ?? false;

  if (!ready) return null;
  if (!user)
    return (
      <div className="space-y-4 px-4 pt-16 text-center">
        <h1 className="text-2xl font-bold">حسابي</h1>
        <p className="text-sm text-muted-foreground">سجّل الدخول لعرض حجوزاتك وطلباتك</p>
        <Link
          to="/auth"
          className="inline-block rounded-2xl bg-primary px-8 py-3 font-bold text-primary-foreground"
        >
          دخول
        </Link>
      </div>
    );

  const signOut = async () => {
    await qc.cancelQueries();
    qc.clear();
    await supabase.auth.signOut();
    navigate({ to: "/auth", replace: true });
  };

  return (
    <div className="space-y-5 px-4 pt-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold">حسابي</h1>
          <p className="text-xs text-muted-foreground">{user.email}</p>
        </div>
        <button onClick={signOut} className="rounded-xl border bg-card px-3 py-2 text-sm">
          خروج
        </button>
      </div>

      <MerchantUpgradeCard
        isMerchant={isMerchant}
        onBecomeMerchant={async () => {
          await becomeMerchant();
          await qc.invalidateQueries({ queryKey: ["my-roles"] });
          await roles.refetch();
        }}
      />

      <section className="space-y-2">
        <h2 className="font-bold">حجوزاتي</h2>
        {res.data?.length === 0 && <p className="text-sm text-muted-foreground">ماكانش حجوزات</p>}
        {res.data?.map((r) => (
          <div
            key={r.id}
            className="flex items-center justify-between rounded-2xl bg-card p-3 shadow-soft"
          >
            <div>
              <p className="font-mono font-bold text-primary">{r.code}</p>
              <p className="text-xs">
                {r.offer?.product?.name} · {r.store?.name}
              </p>
              <p className="text-[11px] text-muted-foreground">{STATUS[r.status]}</p>
            </div>
            {r.status === "pending" && (
              <button
                onClick={async () => {
                  try {
                    await cancelReservation(r.id);
                    qc.invalidateQueries({ queryKey: ["my-reservations"] });
                  } catch (e) {
                    toast.error((e as Error).message);
                  }
                }}
                className="text-xs font-semibold text-danger"
              >
                إلغاء
              </button>
            )}
          </div>
        ))}
      </section>
      <section className="space-y-2">
        <h2 className="font-bold">طلباتي</h2>
        {orders.data?.length === 0 && <p className="text-sm text-muted-foreground">ماكانش طلبات</p>}
        {orders.data?.map((o) => (
          <div key={o.id} className="rounded-2xl bg-card p-3 shadow-soft">
            <div className="flex justify-between">
              <b>{formatDA(o.total)}</b>
              <span className="text-xs">{STATUS[o.status]}</span>
            </div>
            <p className="text-xs text-muted-foreground">
              {o.items.map((i) => i.product_name).join("، ")}
            </p>
          </div>
        ))}
      </section>
    </div>
  );
}
